# Seu Discord User ID (numero, NUNCA um token) usado pelo Lanyard
# para trazer foto, nome e "Ouvindo agora" do Spotify em tempo real.
# Como pegar: ative o Modo Desenvolvedor no Discord (Config > Avancado),
# clique com o botao direito no seu perfil e escolha "Copiar ID".
# Antes de usar, entre no servidor do Lanyard: https://discord.gg/lanyard
NEXT_PUBLIC_DISCORD_ID=

# Opcional: contador de visitas. Provisionado automaticamente pela
# integracao Upstash da Vercel (vercel integration add upstash/upstash-kv).
# Sem essas duas, o contador so some da tela.
KV_REST_API_URL=
KV_REST_API_TOKEN=
